# Copy to local/google-drive.env (gitignored) and fill values.
# Also set the same keys on Railway for the live API service.

# Desktop / Web OAuth client (used for browser connect + token exchange)
GOOGLE_DRIVE_CLIENT_ID=your-desktop-or-web-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret

# Android OAuth client (MobiZone APK package) — optional identity / future native Sign-In
GOOGLE_DRIVE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Optional Picker / Maps-style browser key (restrict in Google Cloud)
GOOGLE_DRIVE_API_KEY=

# IMPORTANT: create a "Web application" OAuth client (or add this URI) —
# Desktop-type clients often reject custom HTTPS redirects.
# Authorized redirect URI must match exactly:
GOOGLE_DRIVE_REDIRECT_URI=https://backend-desktop-production-600b.up.railway.app/v1/google-drive/oauth/callback

# Railway: paste the same GOOGLE_DRIVE_* keys into the live API service Variables, then redeploy.
