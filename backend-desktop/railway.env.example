# Paste into Railway → backend-desktop API service → Variables

DATABASE_URL=${{Postgres.DATABASE_URL}}
NODE_ENV=production

JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

SEED_SUPER_ADMIN_EMAIL=superadmin@pops.platform
SEED_SUPER_ADMIN_EMAIL_2=owner@pops.platform
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
SEED_USER_EMAIL=admin.restaurant@pops.demo
SEED_USER_PASSWORD=Owner@12345

CORS_ORIGINS=http://127.0.0.1:1420,tauri://localhost,https://tauri.localhost,http://tauri.localhost,https://backend-desktop-production-5505.up.railway.app

APP_PUBLIC_URL=http://127.0.0.1:1420

# Do NOT set PORT — Railway injects it automatically
