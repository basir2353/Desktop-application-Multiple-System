# Copy these into Railway → backend-desktop API → Variables
# Profile B: multi-replica API for ~2k–10k concurrent POS (with Redis + larger Postgres).
#
# After deploy, open: https://backend-desktop-production-600b.up.railway.app/health/scale
# Expect: "status":"ok", "redisOk":true, "scaleProfile":"high"

SCALE_PROFILE=high

# Per-replica pool. Formula: DATABASE_POOL_MAX × replicas  <  Postgres max_connections
# With PgBouncer: keep this at 10–15. Without PgBouncer + 4 replicas: use 8–10 max.
DATABASE_POOL_MAX=15
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
# Set true when DATABASE_URL points at PgBouncer (transaction mode):
# DATABASE_PGBOUNCER=true

API_MAX_CONCURRENT=200
API_QUEUE_MAX=800

# Required for high profile (shared cache / future queues across replicas)
# REDIS_URL=redis://default:PASSWORD@HOST:PORT

# Heap for 1–2GB Railway container
NODE_OPTIONS=--max-old-space-size=1536

# Keep existing auth/db boot flags
RAILWAY_SKIP_SCHEMA_PUSH=1
RAILWAY_SKIP_SEED_BOOT=1
RAILWAY_ENSURE_AUTH_SCHEMA=1
RAILWAY_RUN_ENSURE_SCHEMA=0
