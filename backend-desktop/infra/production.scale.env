# Railway production variables (600b live API)
# Paste into: Railway → backend-desktop API → Variables
#
# Verify after deploy:
#   https://backend-desktop-production-600b.up.railway.app/health
#   https://backend-desktop-production-600b.up.railway.app/health/scale

NODE_ENV=production
HOST=0.0.0.0
PORT=8080

APP_PUBLIC_URL=https://backend-desktop-production-600b.up.railway.app
CORS_ORIGINS=http://127.0.0.1:1420,http://localhost:1420,tauri://localhost,https://tauri.localhost,http://tauri.localhost,https://backend-desktop-production-600b.up.railway.app

DATABASE_URL=postgresql://postgres:bqqNHmsvmdbnZQkuZCKEDGMHEFHwpQMy@acela.proxy.rlwy.net:41130/railway

JWT_ACCESS_SECRET=rNPppOdsw5UowoY7OCykdKbJ7Ggv1yMFzIez61G6ZcHZc5TpXJqfHB4hQYRdpceU
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

SEED_SUPER_ADMIN_EMAIL=superadmin@pops.platform
SEED_SUPER_ADMIN_EMAIL_2=owner@pops.platform
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
SEED_USER_EMAIL=admin.restaurant@pops.demo
SEED_USER_PASSWORD=Owner@12345

# Scale profile B (10k path foundation)
SCALE_PROFILE=high
DATABASE_POOL_MAX=15
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
API_MAX_CONCURRENT=200
API_QUEUE_MAX=800
NODE_OPTIONS=--max-old-space-size=1536

RAILWAY_SKIP_SCHEMA_PUSH=1
RAILWAY_SKIP_SEED_BOOT=1
RAILWAY_ENSURE_AUTH_SCHEMA=1
RAILWAY_RUN_ENSURE_SCHEMA=0

# REDIS — Railway dashboard se lo (repo mein password nahi hota):
# 1) Project (600b) → New → Database → Redis (add Redis)
# 2) Redis service → Variables → copy REDIS_URL (ya REDISHOST/REDISPORT/REDISPASSWORD)
# 3) API service → Variables → paste full REDIS_URL (reference: ${{Redis.REDIS_URL}})
# Example shape only:
# REDIS_URL=redis://default:xxxx@redis.railway.internal:6379
