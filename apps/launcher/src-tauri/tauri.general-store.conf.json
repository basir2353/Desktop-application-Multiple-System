{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "General Store Management System",
  "identifier": "com.platform.generalstore",
  "version": "0.3.40",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "General Store Management System"
      }
    ]
  },
  "bundle": {
    "shortDescription": "Retail POS & ERP",
    "longDescription": "General Store / Retail Management System — checkout, products, purchases, warehouses, and reports.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/basir2353/pops-desktop-updates/releases/latest/download/latest-general-store.json"
      ]
    }
  }
}

