{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pharmacy Management System",
  "identifier": "com.platform.pharmacy",
  "version": "0.3.38",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pharmacy Management System"
      }
    ]
  },
  "bundle": {
    "shortDescription": "Pharmacy POS & ERP",
