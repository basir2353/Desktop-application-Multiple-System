{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default window capability set for the launcher shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "updater:default",
    "process:default",
    "allow-pra-http-post",
    "allow-printing"
  ]
}
