{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Restaurant Management System",
  "identifier": "com.platform.restaurant",
  "version": "0.3.28",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Restaurant Management System"
      }
    ]
  },
  "bundle": {
    "shortDescription": "Restaurant POS & ERP",
