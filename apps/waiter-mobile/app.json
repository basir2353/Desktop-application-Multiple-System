{
  "expo": {
    "name": "POPS Waiter",
    "slug": "pops-waiter",
    "version": "1.1.67",
    "orientation": "portrait",
    "scheme": "pops-waiter",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1218",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0A1218"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.platform.pops.waiter"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1218"
      },
      "package": "com.platform.pops.waiter",
      "versionCode": 1167,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
