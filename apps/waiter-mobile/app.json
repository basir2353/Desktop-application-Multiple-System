{
  "expo": {
    "name": "POPS Waiter",
    "slug": "pops-waiter",
    "version": "1.1.66",
    "orientation": "portrait",
    "scheme": "pops-waiter",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1220",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.platform.pops.waiter"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.platform.pops.waiter",
      "versionCode": 1166,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
