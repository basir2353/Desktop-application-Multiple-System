{
  "expo": {
    "name": "POPS Waiter",
    "slug": "pops-waiter",
    "version": "1.1.75",
    "orientation": "portrait",
    "scheme": "pops-waiter",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1218",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#0A1218"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.platform.pops.waiter"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1218"
      },
      "package": "com.platform.pops.waiter",
      "versionCode": 1175,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "REQUEST_INSTALL_PACKAGES",
        "CAMERA",
        "android.permission.CAMERA"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/Ionicons.ttf"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MobiZone needs the camera to scan IMEI barcodes and capture CNIC / party photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MobiZone needs the camera to attach seller / buyer photos and CNIC images."
        }
      ]
    ]
  }
}
